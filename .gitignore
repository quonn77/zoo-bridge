# ---- Rust (GitHub template) --------------------------------------------------
# Generated by Cargo: compiled files and executables
debug
target
# Backup files generated by rustfmt
**/*.rs.bk
# MSVC Windows builds of rustc store debugging information here
*.pdb
# Generated by cargo mutants
**/mutants.out*/
# rustc stack traces on internal compiler errors
rustc-ice-*.txt

# ---- Build outputs ---------------------------------------------------------------
# WASM component built by `openidea-plugin build` (plugin/dist/plugin.wasm)
plugin/dist/
plugin/target/
# Sidecar: dependencies and compiled JavaScript (`npm run build`)
sidecar/node_modules/
sidecar/dist/
# Packaged plugins (`openidea-plugin pack`)
*.oiplugin

# ---- Generated third-party code ----------------------------------------------------
# Zoo Code's webview UI, copied by scripts/copy-webview-ui.mjs (Apache-2.0,
# regenerate with `node scripts/copy-webview-ui.mjs`)
plugin/webview/zoo/

# ---- Local state and secrets ---------------------------------------------------
# The sidecar's data directory when run outside OpenIDEA (state, settings, API keys)
.zoo-openidea/
zoo-data/
sidecar.port
.env
.env.*
# Claude Code local settings
.claude/settings.local.json

# ---- Logs, editors, OS ---------------------------------------------------------------
*.log
npm-debug.log*
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ---- Packaging (scripts/package.mjs) ---------------------------------------------
# Bundled sidecar embedded into the plugin, licence copies, packages
plugin/sidecar-bundle/
plugin/LICENSE
plugin/NOTICE
/dist/
