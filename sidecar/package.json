{
  "name": "zoocode-openidea-sidecar",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Node.js sidecar of Zoo Code for OpenIDEA: hosts the Zoo Code VS Code extension and talks to the OpenIDEA plugin over a loopback WebSocket.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "test": "tsc -p . && node --test \"dist/test/**/*.test.js\"",
    "e2e": "tsc -p . && node scripts/e2e-execute.mjs"
  },
  "dependencies": {
    "vscode-uri": "^3.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.0"
  }
}
